# --- Secrets (NEVER commit real values; only .env.example is tracked) ---
.env
.env.*
!.env.example
!config/.env.example
*credentials*
auth-tokens.json
webhook-secrets.json

# --- Operational state (never sync from repo into runtime) ---
inboxes/
outboxes/
blackboard/
telegram/
logs/
memory/
audit-log/
state/
agents/*/memory/
agents/*/state/
agents/*/workspace/
.concurrency-guard.*

# --- Cloned project repos inside agent workspaces (T1+ separation) ---
agents/*/repos/

# --- Python ---
__pycache__/
*.pyc
*.pyo
.pytest_cache/
.mypy_cache/
.ruff_cache/
*.egg-info/
.venv/
venv/

# --- Node ---
node_modules/
npm-debug.log
.pnpm-debug.log
.yarn/
*.tsbuildinfo

# --- Backups, generated artifacts ---
*.bak
*.bak-*
*.tmp
*.swp
*.swo
*~

# --- Large binaries (don't commit; route through Drive/S3 if ever needed) ---
*.mp4
*.mov
*.zip
*.tar
*.tar.gz
*.archived
*.sqlite
*.sqlite3
*.db

# --- Generated dirs ---
gdoc_images/
screenshots/
.claude/cache/

# --- Local Claude Code settings (per-user permission overrides) ---
.claude/settings.local.json

# --- IDE ---
.idea/
.vscode/
*.iml

# --- macOS ---
.DS_Store
._*

# --- Linux ---
*.swp
.directory
