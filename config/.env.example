# ourliberty-agent-core — Environment Variables Template
#
# Copy to /home/larry/credentials/.env.larry on the VM (mode 600), fill in real values.
# NEVER commit real values to git. Only this template (.env.example) is tracked.
#
# Current as of: 2026-05-08 (Phase A bootstrap)

# === Anthropic ===
# API key for orchestrator scripts and headless Claude SDK calls.
# Long-running interactive agents use Claude Max OAuth instead (set up via `claude login` on the VM).
ANTHROPIC_API_KEY=

# === GitHub ===
# Personal Access Token (fine-grained) for agent commits/PRs from the VM.
# Scopes needed: contents:write, pull_requests:write, issues:write on the active T0 repos only.
GITHUB_TOKEN=

# === DigitalOcean ===
# For self-managing the droplet (snapshots, resize, DNS via DO API).
# Scope: full access; rotate every 90 days.
DIGITALOCEAN_TOKEN=

# === Cloudflare ===
# For DNS record management on ourliberty.dev.
# Scope: Zone DNS:Edit on ourliberty.dev only.
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_ZONE_ID=

# === Telegram (one bot per agent — added as agents come online) ===
TELEGRAM_BOT_TOKEN_BEACON=
TELEGRAM_BOT_TOKEN_FORGE=
TELEGRAM_BOT_TOKEN_MIRROR=
TELEGRAM_BOT_TOKEN_PULSE=
TELEGRAM_BOT_TOKEN_AIDE=
# System / cycle channel
TELEGRAM_BOT_TOKEN_SYSTEM=
# Larry's Telegram numeric chat ID (target for direct messages; resolve via @userinfobot)
TELEGRAM_CHAT_ID_LARRY=

# === Vercel (Phase F — Mini Brains deployment) ===
VERCEL_TOKEN=
VERCEL_ORG_ID=
VERCEL_PROJECT_ID=

# === Supabase (Phase F — Mini Brains storage / pgvector) ===
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# === Google Workspace (Phase E — Aide) ===
# OAuth credentials for Aide; obtained via Google Cloud Console.
# Service Account or OAuth 2.0 Client ID — TBD when wiring Aide.
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_OAUTH_REFRESH_TOKEN=
