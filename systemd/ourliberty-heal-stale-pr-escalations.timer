[Unit]
Description=Run the stale/synthetic PR-escalation sweeper every 30 minutes

[Timer]
# OnCalendar (not OnUnitActiveSec) per the OnUnitActiveSec-dies lesson: a missed
# tick (host asleep / unit inactive) must still fire on the next wall-clock slot.
# Offset off the round :00/:30 boundary (and off the :07 board-reconcile slot) so
# this gh-touching healer doesn't contend with the other git/gh healers.
OnCalendar=*-*-* *:22/30:00
RandomizedDelaySec=120
Persistent=true
Unit=ourliberty-heal-stale-pr-escalations.service

[Install]
WantedBy=timers.target
