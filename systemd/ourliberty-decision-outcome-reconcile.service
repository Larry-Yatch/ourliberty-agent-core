[Unit]
Description=Join the team build result onto Larry's decisions — reconcile PR-coordinate decisions in the decision-outcome ledger against GitHub truth (Operator Feed Loop slice 2)
Documentation=https://github.com/Larry-Yatch/ourliberty-agent-core/blob/main/scripts/decision_outcome_reconcile.py
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=larry
Group=larry
WorkingDirectory=/home/larry/agent-core
EnvironmentFile=/home/larry/credentials/.env.larry
Environment="HOME=/home/larry"
Environment="PATH=/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin"

ExecStart=/usr/bin/python3 /home/larry/agent-core/scripts/decision_outcome_reconcile.py --once

TimeoutStartSec=180

StandardOutput=journal
StandardError=journal
SyslogIdentifier=ourliberty-decision-outcome-reconcile

# Memory cap: bounded gh calls + append-only ledger join; small.
MemoryMax=256M
MemoryHigh=128M

# Hardening — read-only data producer: writes ONLY the append-only ledger +
# state + logs under ~/agents; reads everything else (incl. missions.json).
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=/home/larry/agents /tmp
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictSUIDSGID=true
