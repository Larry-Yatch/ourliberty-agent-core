[Unit]
Description=Spec-gauntlet silent-failure gauge — surface N consecutive errored/incomplete gauntlets to chain_events (info-only, no DMs; makes a stuck fail-open gate visible)
Documentation=https://github.com/Larry-Yatch/ourliberty-agent-core/blob/main/scripts/spec_review_silent_failure_gauge.py
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=larry
Group=larry
WorkingDirectory=/home/larry/agent-core
EnvironmentFile=/home/larry/credentials/.env.larry
Environment="HOME=/home/larry"
Environment="PATH=/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin"

ExecStart=/usr/bin/python3 /home/larry/agent-core/scripts/spec_review_silent_failure_gauge.py --once

TimeoutStartSec=60

StandardOutput=journal
StandardError=journal
SyslogIdentifier=ourliberty-spec-review-silent-failure-gauge

# Memory cap: pure read of small conclusion JSON files + arithmetic; never needs more than 128M.
MemoryMax=128M
MemoryHigh=64M

# Hardening — matches the mirror-queue-wait gauge pattern. Read-only everywhere
# except the gauge's own state file + log under ~/agents.
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=/home/larry/agents /tmp
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictSUIDSGID=true

[Install]
WantedBy=multi-user.target
