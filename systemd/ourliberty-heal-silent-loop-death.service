[Unit]
Description=Self-healing healer — detect agent self-scheduled re-queue loops that died silently
Documentation=https://github.com/Larry-Yatch/ourliberty-agent-core/blob/main/scripts/heal_silent_loop_death.py
After=network.target

[Service]
Type=oneshot
User=larry
Group=larry
EnvironmentFile=/home/larry/credentials/.env.larry
Environment="HOME=/home/larry"
Environment="PATH=/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin"
ExecStart=/usr/bin/python3 /home/larry/agent-core/scripts/heal_silent_loop_death.py
TimeoutStartSec=60
Nice=10
StandardOutput=journal
StandardError=journal
SyslogIdentifier=ourliberty-heal-silent-loop-death
