[Unit]
Description=Monthly (first Monday) run of Pulse Check VI — PRIME DIRECTIVE posture

[Timer]
# OnCalendar (absolute wall-clock) per the OnUnitActiveSec-dies lesson.
# First Monday of the month mirrors the cadence-config entry (cadence_hours=840).
# The analyzer's own month-sentinel (check-vi-<YYYY-MM>.json) makes a Persistent
# catch-up or ad-hoc re-run within the same month a clean no-op.
# 04:59 droplet-local: off-peak; >=10 min from check-v (04:49) so the 300s
# RandomizedDelaySec jitter cannot overlap the stagger.
OnCalendar=Mon *-*-01..07 04:59:00
Persistent=true
RandomizedDelaySec=300
Unit=ourliberty-pulse-check-vi.service

[Install]
WantedBy=timers.target
