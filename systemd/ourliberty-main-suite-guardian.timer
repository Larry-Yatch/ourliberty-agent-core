[Unit]
Description=Run the Ourliberty Main-Suite Green Guardian nightly at 03:30 UTC
Documentation=https://github.com/Larry-Yatch/ourliberty-agent-core/blob/main/agents/beacon/specs/main-suite-green-guardian.md

[Timer]
# 03:30 UTC nightly (L7). Quiet window on the droplet; the guardian single-
# flights with the regbaseline warmer so it never stacks a suite run.
OnCalendar=*-*-* 03:30:00 UTC
# Run on next boot if the system was off when a run was due.
Persistent=true
# Spread the start 0-10 min so a fleet-wide :30 doesn't all-hit at once.
RandomizedDelaySec=600
Unit=ourliberty-main-suite-guardian.service

[Install]
WantedBy=timers.target
