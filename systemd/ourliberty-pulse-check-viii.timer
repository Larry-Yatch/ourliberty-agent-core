[Unit]
Description=Weekly (Monday) run of Pulse Check VIII — burn-rate-signal validity

[Timer]
# OnCalendar (absolute wall-clock) per the OnUnitActiveSec-dies lesson. Weekly
# Monday mirrors the cadence-config entry (cadence_hours=168). The analyzer's
# own week-Monday sentinel (check-viii-<monday>.json) makes a Persistent
# catch-up or ad-hoc re-run within the same week a clean no-op.
# 05:09 droplet-local: off-peak; >=10 min from check-vi (04:59) so the 300s
# RandomizedDelaySec jitter cannot overlap the stagger.
OnCalendar=Mon *-*-* 05:09:00
Persistent=true
RandomizedDelaySec=300
Unit=ourliberty-pulse-check-viii.service

[Install]
WantedBy=timers.target
