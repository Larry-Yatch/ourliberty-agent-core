[Unit]
Description=Run Ourliberty pipeline-stall healer every 15 minutes
Documentation=https://github.com/Larry-Yatch/ourliberty-agent-core/blob/main/runbooks/heal-pipeline-stall.md

[Timer]
# First fire 10 min after boot (let the watcher + notifier settle), then every 15 min.
OnBootSec=10min
OnUnitActiveSec=15min
# Add up to 2 min of random jitter so we don't lock-step with other 15-min healers.
RandomizedDelaySec=2min
AccuracySec=30s

Unit=ourliberty-heal-pipeline-stall.service

[Install]
WantedBy=timers.target
