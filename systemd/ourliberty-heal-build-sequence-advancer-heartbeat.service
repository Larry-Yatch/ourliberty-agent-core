[Unit]
Description=Healer — DM Larry if build_sequence_advancer heartbeat is stale (E-orchestrator PR-S2)
Documentation=https://github.com/Larry-Yatch/ourliberty-agent-core/blob/main/scripts/heal_build_sequence_advancer_heartbeat.py
After=network.target

[Service]
Type=oneshot
User=larry
Group=larry
EnvironmentFile=/home/larry/credentials/.env.larry
Environment="HOME=/home/larry"
Environment="PATH=/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin"
ExecStart=/usr/bin/python3 /home/larry/agent-core/scripts/heal_build_sequence_advancer_heartbeat.py
TimeoutStartSec=60
Nice=10
StandardOutput=journal
StandardError=journal
SyslogIdentifier=ourliberty-heal-build-sequence-advancer-heartbeat
