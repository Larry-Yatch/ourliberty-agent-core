[Unit]
Description=Ourliberty watchdog — broad system health monitor for agent processes
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=larry
Group=larry
WorkingDirectory=/home/larry/agent-core
EnvironmentFile=/home/larry/credentials/.env.larry
Environment="HOME=/home/larry"
Environment="PATH=/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin"

ExecStart=/usr/bin/python3 /home/larry/agent-core/scripts/watchdog.py

TimeoutStartSec=180

StandardOutput=journal
StandardError=journal
SyslogIdentifier=ourliberty-watchdog

# NoNewPrivileges intentionally NOT set — watchdog must `sudo -n systemctl
# start/restart` the daemons it auto-recovers (Q1-Dial-3 carve-out). Larry
# has NOPASSWD sudo (see reference_droplet) so `sudo -n` succeeds silently
# at the shell, but NoNewPrivileges blocks the kernel-level setuid path
# sudo needs regardless of sudoers config. The remaining hardening below
# preserves the rest of the protection envelope.

# PrivateTmp intentionally NOT set — watchdog uses scripts/bot_liveness_policy.py
# to inspect /tmp/tmux-1000/default for bots launched in tmux mode (e.g., pulse-bot).
# PrivateTmp=true gives the unit a private /tmp namespace that hides the user's
# tmux socket, so tmux has-session always fails and emits false bots:pulse:tmux
# alerts. The remaining hardening (ProtectSystem=strict, ReadWritePaths, kernel
# protections) preserves the rest of the envelope.
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=/home/larry/agents /home/larry/agent-core /home/larry/credentials
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictSUIDSGID=true
