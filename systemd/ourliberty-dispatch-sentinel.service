[Unit]
Description=Ourliberty dispatch sentinel — detects inbox stalls + in-flight stalls + stale leases
Documentation=https://github.com/Larry-Yatch/ourliberty-agent-core/blob/main/scripts/dispatch_sentinel.py
After=network.target

[Service]
Type=oneshot
User=larry
Group=larry
EnvironmentFile=/home/larry/credentials/.env.larry
Environment="HOME=/home/larry"
Environment="PATH=/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin"
ExecStart=/usr/bin/python3 /home/larry/agent-core/scripts/dispatch_sentinel.py
TimeoutStartSec=120
Nice=10
StandardOutput=journal
StandardError=journal
SyslogIdentifier=ourliberty-dispatch-sentinel
