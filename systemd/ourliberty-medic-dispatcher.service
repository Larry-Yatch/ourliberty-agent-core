[Unit]
Description=Ourliberty Medic Dispatcher -- cheap trigger for the Medic alert-operator (PR2 act-branch, silence-only -- Stage 1)
Documentation=https://github.com/Larry-Yatch/ourliberty-agent-core/blob/main/docs/medic-operator-brief.md
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=larry
Group=larry
WorkingDirectory=/home/larry/agent-core
EnvironmentFile=/home/larry/credentials/.env.larry
Environment="HOME=/home/larry"
Environment="PATH=/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin"
Environment="AGENT=medic"
# Hard enable-flag for the act-branch; ships ON (active). It has been ON since
# the PR1 scaffold (the act-branch was held dark by the run_medic.sh prompt, not
# this flag), so Stage 1 (silence-only) requires no change here -- the flag is
# already truthy and inherits cleanly to the claude child:
#   unit env -> medic_dispatcher.py (subprocess.run, no env=) -> run_medic.sh
#   -> claude --print -> scripts/medic_actions.py:_enable_flag_ok().
# With Stage 1, Medic auto-silences proven-benign alert CLASSES; auto-restart
# stays OFF (config/medic-reversible-targets.json restart allowlists are empty).
# To pause Medic without disabling the timer, either touch ~/agents/medic.disabled,
# touch ~/agents/healers.disabled, or `systemctl edit` this unit and set
# OURLIBERTY_MEDIC_ENABLED=0 (every gate is re-checked at action time).
Environment="OURLIBERTY_MEDIC_ENABLED=1"

ExecStart=/usr/bin/python3 /home/larry/agent-core/scripts/medic_dispatcher.py

TimeoutStartSec=1500

StandardOutput=journal
StandardError=journal
SyslogIdentifier=ourliberty-medic-dispatcher

# Memory cap: the dispatcher itself is tiny (just gates + queue scan).
# The Claude operator it invokes runs as a child of run_medic.sh and
# inherits this cap; sonnet-4-6 fits comfortably under 2G.
MemoryMax=2G
TasksMax=64

# Hardening (mirrors ourliberty-cycle.service).
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=/home/larry/agents /home/larry/agent-core /home/larry/credentials /home/larry/.claude /home/larry/.claude.json /home/larry/.local /home/larry/.cache /tmp
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictSUIDSGID=true

[Install]
WantedBy=multi-user.target
