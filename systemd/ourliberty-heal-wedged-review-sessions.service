[Unit]
Description=Self-healing healer — reap wedged Mirror/Forge review claude sessions
Documentation=https://github.com/Larry-Yatch/ourliberty-agent-core/blob/main/scripts/heal_wedged_review_sessions.py
After=network.target

[Service]
Type=oneshot
User=larry
Group=larry
EnvironmentFile=/home/larry/credentials/.env.larry
Environment="HOME=/home/larry"
Environment="PATH=/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin"
ExecStart=/usr/bin/python3 /home/larry/agent-core/scripts/heal_wedged_review_sessions.py
TimeoutStartSec=120
Nice=10
StandardOutput=journal
StandardError=journal
SyslogIdentifier=ourliberty-heal-wedged-review-sessions
