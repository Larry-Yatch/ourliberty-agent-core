[Unit]
Description=Score the proposed-missions pile for staleness (read-only) and write ranked stale-candidates (Operator Feed Loop slice 3)
Documentation=https://github.com/Larry-Yatch/ourliberty-agent-core/blob/main/scripts/mission_staleness.py
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=larry
Group=larry
WorkingDirectory=/home/larry/agent-core
EnvironmentFile=/home/larry/credentials/.env.larry
Environment="HOME=/home/larry"
Environment="PATH=/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin"

ExecStart=/usr/bin/python3 /home/larry/agent-core/scripts/mission_staleness.py --once

TimeoutStartSec=300

StandardOutput=journal
StandardError=journal
SyslogIdentifier=ourliberty-mission-staleness

# Memory cap: read-only scan of the ~232-item proposed-missions pile; small.
MemoryMax=256M
MemoryHigh=128M

# Hardening — read-only data producer: opens missions.json READ-ONLY, writes
# ONLY its ranked stale-candidates state + logs under ~/agents.
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=/home/larry/agents /tmp
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictSUIDSGID=true
