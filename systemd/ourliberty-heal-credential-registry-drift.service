[Unit]
Description=Self-healing healer — credential registry drift (E1.5.2)
Documentation=https://github.com/Larry-Yatch/ourliberty-agent-core/blob/main/scripts/heal_credential_registry_drift.py
After=network.target

[Service]
Type=oneshot
User=larry
Group=larry
EnvironmentFile=/home/larry/credentials/.env.larry
Environment="HOME=/home/larry"
Environment="PATH=/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin"
# E1.5.2 activation gate. Per shared/credentials-discipline.md: default
# OFF until verified live. When unset (or != "true"), the healer runs in
# DRY-RUN mode — it logs drifts and DMs Larry one-time activation
# instructions, but does NOT send per-drift DMs. To activate after
# verification:
#   sudo systemctl edit ourliberty-heal-credential-registry-drift.service
# then add a line in the [Service] section:
#   Environment="OURLIBERTY_CREDENTIALS_HEALER_ENABLED=true"
# then `sudo systemctl restart ourliberty-heal-credential-registry-drift.timer`.
Environment="OURLIBERTY_CREDENTIALS_HEALER_ENABLED=false"
ExecStart=/usr/bin/python3 /home/larry/agent-core/scripts/heal_credential_registry_drift.py
TimeoutStartSec=60
Nice=10
StandardOutput=journal
StandardError=journal
SyslogIdentifier=ourliberty-heal-credential-registry-drift
