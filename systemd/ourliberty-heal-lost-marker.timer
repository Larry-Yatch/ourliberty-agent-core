[Unit]
Description=Lost-marker watcher — alert if a rendered Beacon approval marker was never emitted

[Timer]
# OnCalendar (not OnUnitActiveSec) per the OnUnitActiveSec-dies lesson: an
# absolute wall-clock schedule keeps firing even if a run is missed/slow. Every
# 5 min so each rendered marker is re-checked several times once it clears the
# 15-min grace (a marker is evaluated once its render is older than the grace but
# still within the scan window), and the dedup state file makes repeats
# idempotent.
OnCalendar=*-*-* *:0/5:00
Persistent=true
RandomizedDelaySec=30
Unit=ourliberty-heal-lost-marker.service

[Install]
WantedBy=timers.target
