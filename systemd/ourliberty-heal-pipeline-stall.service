[Unit]
Description=Ourliberty Pipeline Stall Healer — proactively DMs Larry on chain stalls (Joe's pipeline_watcher.py analog)
Documentation=https://github.com/Larry-Yatch/ourliberty-agent-core/blob/main/runbooks/heal-pipeline-stall.md
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=larry
Group=larry
WorkingDirectory=/home/larry/agent-core
EnvironmentFile=/home/larry/credentials/.env.larry
Environment="HOME=/home/larry"
Environment="PATH=/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin"

ExecStart=/usr/bin/python3 /home/larry/agent-core/scripts/heal_pipeline_stall.py

TimeoutStartSec=120

StandardOutput=journal
StandardError=journal
SyslogIdentifier=ourliberty-heal-pipeline-stall

# Memory cap: tiny tool, should never need more than 256MB.
MemoryMax=256M
MemoryHigh=128M

# Hardening
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=/home/larry/agents /home/larry/agent-core /home/larry/.claude /home/larry/.local /home/larry/.cache /tmp
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictSUIDSGID=true

[Install]
WantedBy=multi-user.target
