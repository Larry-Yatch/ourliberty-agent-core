[Unit]
Description=Self-healing healer — restart ourliberty-dashboard-api when it runs stale code (git SHA drift vs on-disk HEAD)
Documentation=https://github.com/Larry-Yatch/ourliberty-agent-core/blob/main/scripts/heal_dashboard_api_sha_drift.py
After=network.target

[Service]
Type=oneshot
User=larry
Group=larry
EnvironmentFile=/home/larry/credentials/.env.larry
Environment="HOME=/home/larry"
Environment="PATH=/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin"
ExecStart=/usr/bin/python3 /home/larry/agent-core/scripts/heal_dashboard_api_sha_drift.py
TimeoutStartSec=90
Nice=10
StandardOutput=journal
StandardError=journal
SyslogIdentifier=ourliberty-heal-dashboard-api-sha-drift
