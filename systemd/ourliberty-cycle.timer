[Unit]
Description=Run Ourliberty /cycle on a self-throttling tier cadence
Documentation=https://github.com/Larry-Yatch/ourliberty-agent-core/blob/main/runbooks/cycle-prompt.md

[Timer]
# First run 5 min after boot (let other services settle)
OnBootSec=5min
# PR-β: fire every 5 min (Tier 1 cadence). The script reads
# ~/agents/state/cycle-tier.json and self-throttles to Tier 2 (15 min) or
# Tier 3 (30 min) windows when at higher tiers. See cycle_tier_state.py
# + scripts/run_cycle.sh tier-window gate.
OnUnitActiveSec=5min
# If the system was off when a run was due, run on boot
Persistent=true
Unit=ourliberty-cycle.service

[Install]
WantedBy=timers.target
