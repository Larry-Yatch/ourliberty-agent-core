[Unit]
Description=Run Ourliberty /cycle every hour
Documentation=https://github.com/Larry-Yatch/ourliberty-agent-core/blob/main/runbooks/cycle-prompt.md

[Timer]
# First run 5 min after boot (let other services settle)
OnBootSec=5min
# Then every hour from previous start
OnUnitActiveSec=1h
# If the system was off when a run was due, run on boot
Persistent=true
Unit=ourliberty-cycle.service

[Install]
WantedBy=timers.target
