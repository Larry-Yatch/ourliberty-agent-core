[Unit]
Description=Self-healing healer — recover abandoned inbox tasks (worker exited silently, file stuck)
Documentation=https://github.com/Larry-Yatch/ourliberty-agent-core/blob/main/scripts/heal_abandoned_inbox_tasks.py
After=network.target

[Service]
Type=oneshot
User=larry
Group=larry
EnvironmentFile=/home/larry/credentials/.env.larry
Environment="HOME=/home/larry"
Environment="PATH=/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin"
ExecStart=/usr/bin/python3 /home/larry/agent-core/scripts/heal_abandoned_inbox_tasks.py
TimeoutStartSec=60
Nice=10
StandardOutput=journal
StandardError=journal
SyslogIdentifier=ourliberty-heal-abandoned-inbox-tasks
