[Unit]
Description=Ourliberty Claude Max Burn-Rate Healer — DM Larry at 80% of 5h Tier 1 quota threshold (claude-quota-fixes-v2, 2026-05-27)
Documentation=https://github.com/Larry-Yatch/ourliberty-agent-core/blob/main/scripts/heal_claude_max_burn_rate.py
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=larry
Group=larry
WorkingDirectory=/home/larry/agent-core
EnvironmentFile=/home/larry/credentials/.env.larry
Environment="HOME=/home/larry"
Environment="PATH=/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin"

ExecStart=/usr/bin/python3 /home/larry/agent-core/scripts/heal_claude_max_burn_rate.py

TimeoutStartSec=60

StandardOutput=journal
StandardError=journal
SyslogIdentifier=ourliberty-heal-claude-max-burn-rate

# Memory cap: pure-arithmetic read of costs.jsonl, never needs more than 128M.
MemoryMax=128M
MemoryHigh=64M

# Hardening — matches heal-pipeline-stall pattern
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=/home/larry/agents /home/larry/agent-core /home/larry/.claude /home/larry/.claude.json /home/larry/.local /home/larry/.cache /tmp
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictSUIDSGID=true

[Install]
WantedBy=multi-user.target
