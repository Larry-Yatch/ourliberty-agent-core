[Unit]
Description=Surface OFF-BOARD missions whose work already merged (forgotten board-cleanup backstop) — for-Larry needs-you signal only; NEVER mutates the board
Documentation=https://github.com/Larry-Yatch/ourliberty-agent-core/blob/main/scripts/heal_merged_pr_board_reconcile.py
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=larry
Group=larry
WorkingDirectory=/home/larry/agent-core
EnvironmentFile=/home/larry/credentials/.env.larry
Environment="HOME=/home/larry"
Environment="PATH=/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin"

ExecStart=/usr/bin/python3 /home/larry/agent-core/scripts/heal_merged_pr_board_reconcile.py --apply

TimeoutStartSec=300

StandardOutput=journal
StandardError=journal
SyslogIdentifier=ourliberty-heal-merged-pr-board-reconcile

# Reads missions.json (under ~/agent-core) + lists PRs via gh; writes ONLY the
# for-Larry signal under ~/agents/blackboard. Small.
MemoryMax=256M
MemoryHigh=128M

# Hardening — matches the board-drain / heal-undispatched-pr-review pattern.
# Writes: the for-Larry signal file under ~/agents only. agent-core is read-only
# (no board write — this healer never mutates missions.json). ~/.cache is
# writable so gh's update-check cache write never EROFS-fails the listing (the
# backstop must not silently die on a read-only cache).
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=/home/larry/agents /home/larry/.cache /tmp
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictSUIDSGID=true

[Install]
WantedBy=multi-user.target
