[Unit]
Description=Run chain_events bookkeeping retention daily (approvals-queue-rework N2)

[Timer]
# Once a day — retention is housekeeping, not a hot loop. 03:17 keeps it off
# the busy top-of-hour and Pulse-cycle boundaries.
OnCalendar=*-*-* 03:17:00
# Up to 5 min of jitter so it never lock-steps with other daily jobs.
RandomizedDelaySec=5min
AccuracySec=1min
Persistent=true

Unit=ourliberty-chain-events-retention.service

[Install]
WantedBy=timers.target
