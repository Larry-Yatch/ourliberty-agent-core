[Unit]
Description=Healer — DM Larry if a PR merged into main without a Mirror REVIEW_PASS
Documentation=https://github.com/Larry-Yatch/ourliberty-agent-core/blob/main/scripts/heal_unreviewed_merge_detector.py
After=network.target

[Service]
Type=oneshot
User=larry
Group=larry
EnvironmentFile=/home/larry/credentials/.env.larry
Environment="HOME=/home/larry"
Environment="PATH=/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin"
# Read-only detector; default ON. Set to "false" to run dry-run (detect + log,
# no DM) during initial verification.
Environment="OURLIBERTY_UNREVIEWED_MERGE_DETECTOR_ENABLED=true"
ExecStart=/usr/bin/python3 /home/larry/agent-core/scripts/heal_unreviewed_merge_detector.py
TimeoutStartSec=60
Nice=10
StandardOutput=journal
StandardError=journal
SyslogIdentifier=ourliberty-heal-unreviewed-merge-detector
