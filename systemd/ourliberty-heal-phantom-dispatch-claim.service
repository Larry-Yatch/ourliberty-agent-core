[Unit]
Description=Healer — DM Larry if Beacon claimed a Forge dispatch that never happened
Documentation=https://github.com/Larry-Yatch/ourliberty-agent-core/blob/main/scripts/heal_phantom_dispatch_claim.py
After=network.target

[Service]
Type=oneshot
User=larry
Group=larry
EnvironmentFile=/home/larry/credentials/.env.larry
Environment="HOME=/home/larry"
Environment="PATH=/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin"
ExecStart=/usr/bin/python3 /home/larry/agent-core/scripts/heal_phantom_dispatch_claim.py
TimeoutStartSec=60
Nice=10
StandardOutput=journal
StandardError=journal
SyslogIdentifier=ourliberty-heal-phantom-dispatch-claim
