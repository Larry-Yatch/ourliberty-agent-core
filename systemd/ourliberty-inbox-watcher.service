[Unit]
Description=Ourliberty Inbox Watcher (shared multi-agent dispatch)
Documentation=https://github.com/Larry-Yatch/ourliberty-agent-core/blob/main/scripts/inbox_watcher.py
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=larry
Group=larry
WorkingDirectory=/home/larry/agent-core
EnvironmentFile=/home/larry/credentials/.env.larry
Environment="HOME=/home/larry"
Environment="PATH=/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin"

ExecStart=/usr/bin/python3 /home/larry/agent-core/scripts/inbox_watcher.py

Restart=on-failure
RestartSec=10
# Match the bot units' burst budget. Documented explicit so watchdog
# (and operators reading the unit) know systemd's own retry envelope
# rather than relying on systemd's default.
StartLimitInterval=300
StartLimitBurst=10

StandardOutput=journal
StandardError=journal
SyslogIdentifier=ourliberty-inbox-watcher

# Hardening
# NoNewPrivileges is deliberately DISABLED here (2026-07-08). The regression
# gate's test-isolation wall (scripts/test_isolation_wall.py) relies on
# setuid-root bwrap to build its read-only namespace, because this droplet
# restricts unprivileged user namespaces (kernel.apparmor_restrict_unprivileged_userns=1).
# NoNewPrivileges=true makes the kernel ignore bwrap's setuid bit, so bwrap fails
# ("setting up uid map: Permission denied") and the wall silently falls open —
# tests then cross-contaminate the real ~/agents/logs and the gate emits false
# BLOCK verdicts on clean PRs. The wall is itself the containment we want, so it
# takes priority over NNP for this dispatch service. Proven: `setpriv --no-new-privs
# bwrap --dev-bind / / --ro-bind ~/agents ~/agents -- /bin/true` fails; without it, passes.
NoNewPrivileges=false
PrivateTmp=true
ProtectSystem=strict
ProtectHome=read-only
# .claude-larry-personal (TIER2_HOME) must be writable: 2026-06-10 EROFS
# incident — tier2 dispatch transcripts silently failed to persist, so every
# tier2 build-phase --resume died with 'No conversation found'.
ReadWritePaths=/home/larry/agents /home/larry/agent-core /home/larry/agent-worktrees /home/larry/credentials /home/larry/.claude /home/larry/.claude.json /home/larry/.claude-larry-personal /home/larry/.local /home/larry/.cache /home/larry/ourliberty-dashboard /home/larry/ourliberty-graph /tmp
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictSUIDSGID=true
MemoryMax=8G
TasksMax=512

[Install]
WantedBy=multi-user.target
