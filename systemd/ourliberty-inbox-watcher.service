[Unit]
Description=Ourliberty Inbox Watcher (shared multi-agent dispatch)
Documentation=https://github.com/Larry-Yatch/ourliberty-agent-core/blob/main/scripts/inbox_watcher.py
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=larry
Group=larry
WorkingDirectory=/home/larry/agent-core
EnvironmentFile=/home/larry/credentials/.env.larry
Environment="HOME=/home/larry"
Environment="PATH=/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin"

ExecStart=/usr/bin/python3 /home/larry/agent-core/scripts/inbox_watcher.py

Restart=on-failure
RestartSec=10
# Match the bot units' burst budget. Documented explicit so watchdog
# (and operators reading the unit) know systemd's own retry envelope
# rather than relying on systemd's default.
StartLimitInterval=300
StartLimitBurst=10

StandardOutput=journal
StandardError=journal
SyslogIdentifier=ourliberty-inbox-watcher

# Hardening
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=/home/larry/agents /home/larry/agent-core /home/larry/agent-worktrees /home/larry/credentials /home/larry/.claude /home/larry/.local /home/larry/.cache /home/larry/ourliberty-dashboard /tmp
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictSUIDSGID=true
MemoryMax=4G
TasksMax=512

[Install]
WantedBy=multi-user.target
