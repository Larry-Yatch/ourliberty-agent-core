[Unit]
Description=Sentinel — assert decide-tab parity, alert on persistent approvals drift
Documentation=https://github.com/Larry-Yatch/ourliberty-agent-core/blob/main/scripts/heal_approvals_surface_drift.py
After=network.target

[Service]
Type=oneshot
User=larry
Group=larry
EnvironmentFile=/home/larry/credentials/.env.larry
Environment="HOME=/home/larry"
Environment="PATH=/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin"
ExecStart=/usr/bin/python3 /home/larry/agent-core/scripts/heal_approvals_surface_drift.py
TimeoutStartSec=120
Nice=10
StandardOutput=journal
StandardError=journal
SyslogIdentifier=ourliberty-heal-approvals-surface-drift
