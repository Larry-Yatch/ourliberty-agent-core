[Unit]
Description=Monthly (first Monday) run of Pulse Check V — action-template trust

[Timer]
# OnCalendar (absolute wall-clock) per the OnUnitActiveSec-dies lesson.
# First Monday of the month mirrors the cadence-config entry (cadence_hours=840).
# The analyzer's own month-sentinel (check-v-<YYYY-MM>.json) makes a Persistent
# catch-up or ad-hoc re-run within the same month a clean no-op.
# 04:49 droplet-local: off-peak, offset from check-xi (04:17) / check-iv (04:25) / check-iii (04:41).
OnCalendar=Mon *-*-01..07 04:49:00
Persistent=true
RandomizedDelaySec=300
Unit=ourliberty-pulse-check-v.service

[Install]
WantedBy=timers.target
