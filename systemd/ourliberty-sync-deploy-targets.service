[Unit]
Description=Sync deploy_targets registry against Vercel API (E2.1)
Documentation=https://github.com/Larry-Yatch/ourliberty-agent-core/blob/main/scripts/sync_deploy_targets.py
After=network.target

[Service]
Type=oneshot
User=larry
Group=larry
EnvironmentFile=/home/larry/credentials/.env.larry
Environment="HOME=/home/larry"
Environment="PATH=/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin"
# E2.1 activation gate. Per shared/credentials-discipline.md: default
# OFF until verified live. When unset (or != "true"), the sync script runs
# in DRY-RUN mode — it logs drifts and DMs Larry one-time activation
# instructions, but does NOT send per-drift DMs. To activate after
# verification:
#   sudo systemctl edit ourliberty-sync-deploy-targets.service
# then add a line in the [Service] section:
#   Environment="OURLIBERTY_DEPLOY_TARGETS_SYNC_ENABLED=true"
# then `sudo systemctl restart ourliberty-sync-deploy-targets.timer`.
Environment="OURLIBERTY_DEPLOY_TARGETS_SYNC_ENABLED=false"
ExecStart=/usr/bin/python3 /home/larry/agent-core/scripts/sync_deploy_targets.py --once
TimeoutStartSec=60
Nice=10
StandardOutput=journal
StandardError=journal
SyslogIdentifier=ourliberty-sync-deploy-targets
