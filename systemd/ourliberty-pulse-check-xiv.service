[Unit]
Description=Pulse Check XIV — alert-precision meter (V1: measure + surface, no config change)
Documentation=https://github.com/Larry-Yatch/ourliberty-agent-core/blob/main/scripts/pulse_check_xiv.py
After=network.target
# System-wide halt: when the operator trips EMERGENCY_HALT the unit is skipped
# (condition-failed, not error) — replaces the halt gate the /cycle agent
# enforced before invoking these checks.
ConditionPathExists=!/home/larry/agents/blackboard/EMERGENCY_HALT

[Service]
Type=oneshot
User=larry
Group=larry
EnvironmentFile=/home/larry/credentials/.env.larry
Environment="HOME=/home/larry"
Environment="PATH=/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin"
ExecStart=/usr/bin/python3 /home/larry/agent-core/scripts/pulse_check_xiv.py
TimeoutStartSec=900
Nice=10
StandardOutput=journal
StandardError=journal
SyslogIdentifier=ourliberty-pulse-check-xiv
