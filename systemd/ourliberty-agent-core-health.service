[Unit]
Description=Ourliberty agent-core health check — enforces working-copy discipline (always on main, always clean)
Documentation=https://github.com/Larry-Yatch/ourliberty-agent-core/blob/main/scripts/agent_core_health_check.py
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=larry
Group=larry
WorkingDirectory=/home/larry/agent-core
EnvironmentFile=/home/larry/credentials/.env.larry
Environment="HOME=/home/larry"
Environment="PATH=/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin"

ExecStart=/usr/bin/python3 /home/larry/agent-core/scripts/agent_core_health_check.py

TimeoutStartSec=120

StandardOutput=journal
StandardError=journal
SyslogIdentifier=ourliberty-health

NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=/home/larry/agents /home/larry/agent-core /home/larry/credentials
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictSUIDSGID=true
